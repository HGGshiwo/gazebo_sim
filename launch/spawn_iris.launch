<?xml version="1.0"?>
<launch>
  <arg name="model_name" />
  <arg name="x" default="-10" />
  <arg name="y" default="-10" />
  <arg name="z" default="0.2" />
  
  <!-- <param name="robot_description" command="$(find xacro)/xacro $(find gazebo_sim)/urdf/iris_ardupilot_sensor.xacro" /> -->

  <param name="robot_description2" command="$(find xacro)/xacro $(find gazebo_sim)/urdf/iris.xacro" />

  <!-- <node name="spawn_model" pkg="gazebo_ros" type="spawn_model"
