  <node  name="spawn_urdf" pkg="gazebo_ros" type="spawn_model" args="-file /home/hggshiwo/catkin_ws/src/gazebo_sim/models/iris_with_standoffs_new/model.urdf -urdf -model $(arg model_name) -x $(arg x) -y $(arg y) -z $(arg z)" />

</launch>
  